        <item name="colorControlActivated">#FF5B65</item>
        <item name="android:colorAccent">#FF5B65</item>
        <item name="colorOnPrimary">#020F17</item>
    </style>
    <style name="ZeroChillAccentPink">
        <item name="colorPrimary">#FF69B6</item>
        <item name="colorSecondary">#FF69B6</item>
        <item name="colorControlActivated">#FF69B6</item>
        <item name="android:colorAccent">#FF69B6</item>
        <item name="colorOnPrimary">#020F17</item>
    </style>
    <style name="ZeroChillAccentWhite">
        <item name="colorPrimary">#FFFFFF</item>
        <item name="colorSecondary">#FFFFFF</item>
        <item name="colorControlActivated">#FFFFFF</item>
        <item name="android:colorAccent">#FFFFFF</item>
        <item name="colorOnPrimary">#020F17</item>
    </style>
</resources>
