<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CrazyShit" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/zc_background</item>
        <item name="android:colorBackground">@color/zc_background</item>
        <item name="android:statusBarColor">@color/zc_background</item>
        <item name="android:navigationBarColor">@color/zc_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="colorPrimary">@color/zc_cyan</item>
        <item name="colorOnPrimary">@color/app_on_primary</item>
        <item name="colorSecondary">@color/zc_cyan</item>
        <item name="colorOnSecondary">@color/app_on_primary</item>
        <item name="colorSurface">@color/zc_surface_glass_strong</item>
        <item name="colorOnSurface">@color/zc_text_primary</item>
        <item name="colorSurfaceVariant">@color/zc_surface_glass</item>
        <item name="colorOnSurfaceVariant">@color/zc_text_secondary</item>
        <item name="bottomNavigationStyle">@style/Widget.ZeroChill.BottomNavigation</item>
    </style>
    <style name="Theme.ZeroChill.Account" parent="Theme.CrazyShit">
        <item name="android:autofilledHighlight">@drawable/zc_autofill_highlight</item>
    </style>
    <style name="Theme.ZeroChill.Splash" parent="Theme.CrazyShit">
        <item name="android:windowBackground">@color/zc_background</item>
    </style>
    <style name="Theme.ZeroChill.ShowsWatch" parent="Theme.CrazyShit">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
    <!-- Global theme colors for the main native UI. Media transition windows stay unchanged. -->
    <style name="Theme.ZeroChill.Light" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#FFF7F9FC</item>
        <item name="android:colorBackground">#FFF7F9FC</item>
        <item name="android:statusBarColor">#FFF7F9FC</item>
        <item name="android:navigationBarColor">#FFF7F9FC</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="colorPrimary">#0892D0</item>
        <item name="colorOnPrimary">#020F17</item>
        <item name="colorSecondary">#0892D0</item>
        <item name="colorOnSecondary">#020F17</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#15202E</item>
        <item name="colorSurfaceVariant">#FFF0F3F8</item>
        <item name="colorOnSurfaceVariant">#4F5C6C</item>
        <item name="bottomNavigationStyle">@style/Widget.ZeroChill.BottomNavigation</item>
    </style>
    <style name="Theme.ZeroChill.Dark" parent="Theme.CrazyShit">
        <item name="android:windowBackground">#0D1117</item>
        <item name="android:colorBackground">#0D1117</item>
        <item name="android:statusBarColor">#0D1117</item>
        <item name="android:navigationBarColor">#0D1117</item>
        <item name="colorSurface">#171B21</item>
        <item name="colorOnSurface">#F5F7FA</item>
        <item name="colorSurfaceVariant">#1B2027</item>
    </style>
    <style name="Theme.ZeroChill.Light.Account" parent="Theme.ZeroChill.Light">
        <item name="android:autofilledHighlight">@drawable/zc_autofill_highlight</item>
    </style>
    <style name="Theme.ZeroChill.Dark.Account" parent="Theme.ZeroChill.Dark">
        <item name="android:autofilledHighlight">@drawable/zc_autofill_highlight</item>
    </style>
    <style name="ZeroChillAccentPurple">
        <item name="colorPrimary">#A06CFF</item>
        <item name="colorSecondary">#A06CFF</item>
        <item name="colorControlActivated">#A06CFF</item>
        <item name="android:colorAccent">#A06CFF</item>
        <item name="colorOnPrimary">#020F17</item>
    </style>
    <style name="ZeroChillAccentBlue">
        <item name="colorPrimary">#4A89FF</item>
        <item name="colorSecondary">#4A89FF</item>
        <item name="colorControlActivated">#4A89FF</item>
        <item name="android:colorAccent">#4A89FF</item>
        <item name="colorOnPrimary">#020F17</item>
    </style>
    <style name="ZeroChillAccentGreen">
        <item name="colorPrimary">#42D39B</item>
        <item name="colorSecondary">#42D39B</item>
        <item name="colorControlActivated">#42D39B</item>
        <item name="android:colorAccent">#42D39B</item>
        <item name="colorOnPrimary">#020F17</item>
    </style>
    <style name="ZeroChillAccentRed">
