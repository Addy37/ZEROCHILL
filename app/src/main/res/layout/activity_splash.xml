<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zc_background">

    <com.webapp.crazyshit.SplashBrandLighting
        android:id="@+id/splashBrandLighting"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/splashMascot"
            android:layout_width="248dp"
            android:layout_height="248dp">

            <View
                android:id="@+id/splashMascotGlow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0" />

            <ImageView
                android:id="@+id/splashHorns"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0"
                android:contentDescription="@null"
                android:src="@drawable/zc_launch_horns" />

            <ImageView
                android:id="@+id/splashFace"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0"
                android:contentDescription="@null"
                android:src="@drawable/zc_launch_face" />

            <ImageView
                android:id="@+id/splashOutline"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0"
                android:contentDescription="@null"
                android:src="@drawable/zc_launch_outline" />

            <ImageView
                android:id="@+id/splashXEye"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0"
                android:contentDescription="@null"
                android:src="@drawable/zc_launch_x_eye" />

            <ImageView
                android:id="@+id/splashAngryEye"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0"
                android:contentDescription="@null"
                android:src="@drawable/zc_launch_angry_eye" />

            <ImageView
                android:id="@+id/splashTeeth"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0"
                android:contentDescription="@null"
                android:src="@drawable/zc_launch_teeth" />

            <ImageView
                android:id="@+id/splashTongue"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0"
                android:contentDescription="@null"
                android:src="@drawable/zc_launch_tongue" />

        </FrameLayout>

        <LinearLayout
            android:id="@+id/splashWordmark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:alpha="0"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="ZERO"
                android:textColor="#F3F4F6"
                android:textSize="38sp"
                android:textStyle="bold|italic" />

            <TextView
                android:id="@+id/splashChill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="CHILL"
                android:textColor="@color/zc_cyan"
                android:textSize="38sp"
                android:textStyle="bold|italic" />
        </LinearLayout>

        <TextView
            android:id="@+id/splashTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:alpha="0"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.20"
            android:text="@string/zerochill_tagline"
            android:textAllCaps="true"
            android:textColor="@color/zc_text_secondary"
            android:textSize="11sp" />

        <View
            android:id="@+id/splashBrandUnderline"
            android:layout_width="140dp"
            android:layout_height="3dp"
            android:layout_marginTop="18dp"
            android:alpha="0"
            android:importantForAccessibility="no" />
    </LinearLayout>
</FrameLayout>
